{
  "name": "lgcy",
  "description": "LGCY — standalone TUI client for OpenAI-compatible, Anthropic-compatible, and OpenCode-routed model providers",
  "module": "src/app/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/app/main.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build --compile --outfile dist/lgcy src/app/main.ts",
    "install:local": "bun run scripts/install-local.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
