{
  "name": "lgcy",
  "version": "0.1.0",
  "description": "LGCY: standalone terminal client for OpenAI-compatible, Anthropic-compatible, and OpenCode-routed model providers",
  "homepage": "https://floydslabs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CaptainPhantasy/LGCY.git"
  },
  "bugs": {
    "url": "https://github.com/CaptainPhantasy/LGCY/issues"
  },
  "author": "Floyd's Labs",
  "license": "AGPL-3.0-or-later",
  "files": [
    "src",
    "dist/lgcy",
    "LICENSE",
    "README.md"
  ],
  "module": "src/app/main.ts",
  "type": "module",
  "private": true,
  "bin": {
    "lgcy": "./dist/lgcy"
  },
  "scripts": {
    "start": "bun run src/app/main.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "build": "bun build --compile --outfile dist/lgcy src/app/main.ts",
    "install:local": "bun run scripts/install-local.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
